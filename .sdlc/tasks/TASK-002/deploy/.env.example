# .env.example — TASK-002 Deploy(Init) 產出
#
# 此檔為環境變數範本（永遠產出）；複製到 .env（gitignored）填入實際值。
# 對應 service-contract.yaml 完整 env vars 清單。
#
# 安全性：禁止 commit 任何含實際密鑰的 .env 檔到 git！
# .gitignore 必須包含：.env / .env.local / .env.*.local

# ========== PostgreSQL 連線（TASK-002 新增 5 + 4 個）==========

# 連線目標（dev: localhost; prod: Railway 內部 host）
POSTGRES_HOST=localhost

# Port（標準 PG port）
POSTGRES_PORT=5432

# 使用者
POSTGRES_USER=snowtrip

# 密碼 — ⚠️ Secret：絕不可 commit 到 git，dev 自選強密碼，prod Railway dashboard 設定
POSTGRES_PASSWORD=CHANGE_ME_min_16_chars_in_dotenv

# 資料庫名稱
POSTGRES_DB=snowtrip

# SSL 模式 — dev/staging/prod 全部 disable（自建 container — USER CONFIRMED 2026-06-09；future hardening 留後續 TASK）
POSTGRES_SSL_MODE=disable

# Connection pool（NFR-005）
POSTGRES_POOL_MIN=2
POSTGRES_POOL_MAX=10
POSTGRES_POOL_TIMEOUT_MS=5000

# ========== DATABASE_URL（替代方案 — 自建 container 需手動設定）==========
# 若使用此 var，上方 POSTGRES_* 5 個可省略；SD 階段決定支援哪種模式
# 格式：postgresql://user:password@host:port/dbname?sslmode=disable
# Railway prod 使用 docker service name=postgres 於內網直連
DATABASE_URL=postgresql://snowtrip:CHANGE_ME_min_16_chars_in_dotenv@localhost:5432/snowtrip?sslmode=disable

# ========== 既有 env vars [REUSE: from TASK-001]==========

# JWT 簽章密鑰 — ⚠️ Secret：fail-fast 機制（PATTERN-007 + HOTFIX-B；未設則應用啟動失敗）
SECRET_KEY=CHANGE_ME_in_dotenv_min_32_chars_for_JWT_HS256_signing

# SerpAPI 金鑰（機票查詢功能 — TASK-001 既有）
SERPAPI_API_KEY=CHANGE_ME_obtain_from_serpapi.com

# 應用 port（本機 dev 用；Railway 用 $PORT 動態注入）
PORT=8000

# ========== 開發專用（非必填）==========

# 啟用 uvicorn --reload（dev 用；prod 不要設）
# UVICORN_RELOAD=true

# 日誌等級（INFO / DEBUG / WARNING / ERROR）
# LOG_LEVEL=INFO
