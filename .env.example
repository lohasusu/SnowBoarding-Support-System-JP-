# SDLC docker-compose .env example (PR 13c — engine-aware tech-stack params)
#
# RECOMMENDED workflow:
#   bash scripts/sdlc-render-docker-env.sh
#   ↑ auto-generates .env / .env.frontend / .env.backend from .sdlc/config.json
#     (this .env.example.tpl is for projects that don't run render-env)
#
# Setup (manual):
#   1. Copy this file to project root as `.env`
#   2. Fill in real secrets (CHANGE the defaults!)
#   3. Make sure `.env` is in `.gitignore` (NEVER commit secrets)
#
# Variable names MUST match what's defined in:
#   - .sdlc/tasks/{TASK-ID}/deploy/service-contract.yaml
#   - docker-compose.yml
#   - the application code (validated by sdlc-env-consistency.sh)

# === PR 13c tech-stack params (auto-derived by sdlc-render-docker-env.sh from config.json) ===
# These drive docker-compose.yml's image / build args / volume / healthcheck variables.
# If you copy this file manually, fill these to match your stack.

# Frontend (defaults: React + Vite)
FE_ENV_PREFIX=VITE_                # VITE_ / NEXT_PUBLIC_ / VUE_APP_ / NUXT_PUBLIC_ / NG_APP_ / PUBLIC_
FE_BUILD_IMAGE=node:22-alpine      # build stage base
FE_SERVE_IMAGE=nginx:alpine        # runtime stage base (use node:22-alpine for SSR Next/Nuxt/SvelteKit)
FE_BUILD_CMD=npm run build         # ng build / npm run build / yarn build / etc.

# Backend (defaults: Node + Express)
BE_RUNTIME=node:22-alpine          # python:3.12-slim / golang:1.22-alpine / mcr.microsoft.com/dotnet/aspnet:8.0 / eclipse-temurin:21-jre-alpine / rust:1.78-alpine
BE_PKG_MANAGER=npm                 # npm / pip / go-mod / dotnet / maven / cargo

# Database (defaults: Postgres)
DB_IMAGE=postgres:16-alpine        # postgres:16-alpine / mysql:8.0 / mongo:7 / redis:7-alpine
DB_ENGINE=postgres                 # postgres / mysql / mongodb / redis
DB_DEFAULT_PORT=5432               # Engine default; DB_PORT below can override
DB_ENV_PREFIX=POSTGRES_            # POSTGRES_ / MYSQL_ / MONGO_INITDB_ / REDIS_
DB_DATA_DIR=/var/lib/postgresql/data  # /var/lib/mysql / /data/db / /data
DB_HEALTHCHECK=pg_isready -U $POSTGRES_USER -d $POSTGRES_DB

# === User-editable secrets/ports (preserved across render-env re-runs) ===

# Ports
FE_PORT=3000
BE_PORT=8000
DB_PORT=5432

# Database credentials (also accessed via engine-specific vars below)
DB_NAME=app
DB_USER=app
DB_PASSWORD=CHANGE_ME_IN_LOCAL_ONLY

# Engine-specific DB env vars (DB image reads its own; others ignored)
# Postgres:
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=CHANGE_ME_IN_LOCAL_ONLY
# MySQL:
# MYSQL_DATABASE=app
# MYSQL_USER=app
# MYSQL_PASSWORD=CHANGE_ME_IN_LOCAL_ONLY
# MYSQL_ROOT_PASSWORD=CHANGE_ME_IN_LOCAL_ONLY
# MongoDB:
# MONGO_INITDB_DATABASE=app
# MONGO_INITDB_ROOT_USERNAME=app
# MONGO_INITDB_ROOT_PASSWORD=CHANGE_ME_IN_LOCAL_ONLY

# JWT / Auth
JWT_SECRET=CHANGE_ME_USE_OPENSSL_RAND
# Generate with: openssl rand -hex 32

# External services (uncomment as needed)
# STRIPE_API_KEY=sk_test_...
# REDIS_URL=redis://redis:6379

# ====================================================================
# === TASK-002: PostgreSQL 持久化遷移（SQLite → PG）              ===
# ====================================================================
# 對應 deploy/service-contract.yaml + parameter-plan.md
# 應用程式（web/auth/database.py MOD-101）讀取以下 env vars。
# 優先順序：DATABASE_URL（若設定）→ 個別 POSTGRES_*。

# 自建 container 連線（本機 docker-compose 預設）
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB 已在上方定義（共用）
POSTGRES_SSL_MODE=disable          # 自建 container 預設 disable（USER CONFIRMED 2026-06-09）

# 替代方案：DATABASE_URL（若使用此 var 則 POSTGRES_* 5 個變 optional）
# DATABASE_URL=postgresql://app:changeme@postgres:5432/app?sslmode=disable

# Connection pool (NFR-005 — psycopg_pool)
POSTGRES_POOL_MIN=2
POSTGRES_POOL_MAX=10
POSTGRES_POOL_TIMEOUT_MS=5000

# Docker volume 名稱（test-deploy-init Major-5 補登記）
PG_VOLUME_NAME=sdlc-db-data
PG_DATA_PATH=/var/lib/postgresql/data

# Lifespan bootstrap toggle（test fixture / standalone CLI 可設 0 跳過）
# RUN_DB_BOOTSTRAP=1
